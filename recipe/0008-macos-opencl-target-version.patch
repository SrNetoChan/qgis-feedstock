diff --git a/src/core/qgsopenclutils.h b/src/core/qgsopenclutils.h
index 419a7d9ae0ab..b6e2a3f1a001 100644
--- a/src/core/qgsopenclutils.h
+++ b/src/core/qgsopenclutils.h
@@ -27,9 +27,17 @@
 using namespace Qt::StringLiterals;

 #ifdef Q_OS_MAC
+// Compile against the same OpenCL C++ API level as other platforms.
+// This only affects which cl2.hpp/opencl.hpp symbols are declared at
+// build time; QGIS still explicitly loads Apple's system OpenCL.framework
+// (capped at 1.2) at runtime (see QgsOpenClUtils::init()) and only calls
+// core OpenCL 1.x functionality here, so raising the compile-time ceiling
+// doesn't change runtime behaviour. Targeting 1.2 while conda-forge's
+// khronos-opencl-icd-loader headers report OpenCL 3.0 leaves cl::Device
+// incomplete in the C++ wrapper, breaking the build.
 #define CL_HPP_MINIMUM_OPENCL_VERSION 120
-#define CL_HPP_TARGET_OPENCL_VERSION 120
-#define CL_TARGET_OPENCL_VERSION 120
+#define CL_HPP_TARGET_OPENCL_VERSION 200
+#define CL_TARGET_OPENCL_VERSION 200
 #else
 #define CL_USE_DEPRECATED_OPENCL_1_1_APIS
 #define CL_HPP_TARGET_OPENCL_VERSION 200
